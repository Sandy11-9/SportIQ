# Copy this file to .env and replace the JWT value with a random secret.
SPORTIQ_JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET

# SMTP settings for OTP delivery. Use a provider app password, not your normal password.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=noreply@localhost
